{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}{{#if separateMinorPatch}}{{#if isPatch}}.{{{newMinor}}}{{/if}}{{/if}}{{#if separateMultipleMinor}}{{#if isMinor}}.{{{newMinor}}}{{/if}}{{/if}}.x",
  "configMigration": true,
  "constraints": { "rust": "1.100" },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep CI on the newest Python",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": ["python-version: \"(?<currentValue>\\d+\\.\\d+)\""],
      "depNameTemplate": "docker.io/python",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The Rust that Renovate runs cargo on. From 1.100 on, cargo applies the cooldown in .cargo/config.toml to every crate it locks, transitive ones included",
      "managerFilePatterns": ["/^\\.github/renovate\\.json$/"],
      "matchStrings": ["\"rust\": \"(?<currentValue>\\d+\\.\\d+)\""],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust-version",
      "versioningTemplate": "rust-release-channel"
    }
  ],
  "dependencyDashboard": false,
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":pinDevDependencies",
    "customManagers:githubActionsVersions",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": { "enabled": true, "schedule": ["at any time"] },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "The hook's npm package and the mirror's tag are one oxfmt version, so they go in one pull request",
      "matchPackageNames": ["oxfmt", "oxc-project/mirrors-oxfmt"],
      "groupName": "oxfmt"
    },
    { "matchCurrentVersion": "!/^0/", "matchUpdateTypes": ["minor"], "automerge": true },
    { "matchUpdateTypes": ["lockFileMaintenance", "patch", "replacement"], "automerge": true },
    { "matchManagers": ["github-actions", "pre-commit"], "automerge": true },
    {
      "description": "A new Python is reviewed by hand. A cooldown would count from the last rebuild of an image tag, which keeps part of the update out of the PR",
      "matchPackageNames": ["python", "docker.io/python"],
      "groupName": "python",
      "automerge": false,
      "minimumReleaseAge": null
    }
  ],
  "pre-commit": { "enabled": true },
  "rollbackPrs": true,
  "semanticCommits": "enabled"
}
