{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}{{#if separateMinorPatch}}{{#if isPatch}}.{{{newMinor}}}{{/if}}{{/if}}{{#if separateMultipleMinor}}{{#if isMinor}}.{{{newMinor}}}{{/if}}{{/if}}.x",
  "configMigration": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep CI on the newest Python",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": ["python-version: \"(?<currentValue>\\d+\\.\\d+)\""],
      "depNameTemplate": "docker.io/python",
      "datasourceTemplate": "docker"
    }
  ],
  "dependencyDashboard": { "enabled": false },
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":pinDevDependencies",
    "customManagers:githubActionsVersions",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": { "enabled": true, "schedule": ["at any time"] },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "The hook's npm package and the mirror's tag are one oxfmt version, so they go in one pull request",
      "matchPackageNames": ["oxfmt", "oxc-project/mirrors-oxfmt"],
      "groupName": "oxfmt"
    },
    { "matchCurrentVersion": "!/^0/", "matchUpdateTypes": ["minor"], "automerge": true },
    {
      "description": "Patch, digest, lock file and replacement updates merge themselves once CI passes. digest is the git rev of mimalloc, which the mimalloc test job builds",
      "matchUpdateTypes": ["digest", "lockFileMaintenance", "patch", "replacement"],
      "automerge": true
    },
    { "matchManagers": ["github-actions", "pre-commit"], "automerge": true },
    {
      "description": "A new Python is reviewed by hand. A cooldown would count from the last rebuild of an image tag, which keeps part of the update out of the PR",
      "matchPackageNames": ["python", "docker.io/python"],
      "groupName": "python",
      "automerge": false,
      "minimumReleaseAge": null
    },
    {
      "description": "git-refs gives a commit no release timestamp, so a cooldown would hold back every new commit of a git dependency (mimalloc) forever",
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": null
    }
  ],
  "pre-commit": { "enabled": true },
  "rollbackPrs": true,
  "semanticCommits": "enabled"
}
